# Copiar a .env y completar. .env nunca se sube a git.
POSTGRES_PASSWORD=cambiar_por_una_clave_segura

# Para ejecutar Prisma desde Windows (fuera de Docker) contra la BD del contenedor
DATABASE_URL=postgresql://ipec:cambiar_por_una_clave_segura@localhost:5434/ipec?schema=public

# Token compartido con n8n para leer destinatarios de avisos (generar uno nuevo para producción)
N8N_INTERNAL_TOKEN=cambiar_por_token_aleatorio
