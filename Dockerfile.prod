# Imagen de producción — multi-stage
# Stage 1: instalar todas las dependencias (para el build)
FROM node:24-alpine AS builder
RUN apk add --no-cache openssl libc6-compat
WORKDIR /app

COPY package.json package-lock.json ./
RUN npm ci

COPY . .
RUN npx prisma generate
RUN npm run build

# Stage 2: imagen mínima de producción
FROM node:24-alpine AS runner
RUN apk add --no-cache openssl libc6-compat
WORKDIR /app

ENV NODE_ENV=production
ENV PORT=3000
ENV HOSTNAME="0.0.0.0"

RUN addgroup --system --gid 1001 nodejs && \
    adduser  --system --uid 1001 nextjs

# Next.js standalone output
COPY --from=builder /app/.next/standalone ./
COPY --from=builder /app/.next/static   ./.next/static
COPY --from=builder /app/public          ./public

# Prisma v6 tiene un árbol de dependencias externas profundo (@prisma/config → effect, etc.)
# Copiamos node_modules completo para garantizar que migrate deploy funcione
COPY --from=builder /app/node_modules ./node_modules

# Migraciones y seed
COPY --from=builder /app/prisma   ./prisma
COPY --from=builder /app/messages ./messages

USER nextjs

EXPOSE 3000

# migrate deploy + seed idempotente + servidor de producción
CMD ["sh", "-c", "node node_modules/prisma/build/index.js migrate deploy && node prisma/seed.mjs && node server.js"]
