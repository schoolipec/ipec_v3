# Plantilla de variables de entorno para producción (VPS)
# Copiar como .env en /opt/ipec-v3/ en el VPS
# NUNCA subir el .env real al repositorio

# ─── PostgreSQL ──────────────────────────────────────────────
# Genera una contraseña segura: openssl rand -base64 32
POSTGRES_PASSWORD=CAMBIAR_POR_CONTRASENA_SEGURA

# ─── SuperAdmin inicial ───────────────────────────────────────
# Se crea al primer arranque si no existe el usuario en la BD
SUPERADMIN_EMAIL=correo.real@iglesia.com
SUPERADMIN_NAME=Nombre Real Admin
SUPERADMIN_PASSWORD=CAMBIAR_POR_CONTRASENA_REAL

# ─── Sesiones ─────────────────────────────────────────────────
# Genera un secreto aleatorio: openssl rand -hex 32
SESSION_SECRET=CAMBIAR_POR_SECRETO_ALEATORIO_SEGURO

# Avisos de oración a n8n (mismo secreto que el flujo del webhook)
PRAYER_NOTIFICATION_WEBHOOK_URL=https://workflow.suplenitud.com/webhook/a4f55d45-25af-4d10-a83e-7984fe45cb5e
PRAYER_NOTIFICATION_WEBHOOK_SECRET=CAMBIAR_POR_SECRETO_DEL_WEBHOOK
APP_PUBLIC_URL=https://v3.suplenitud.com

# Correo de invitaciones (mismo no-reply que usa la demo)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=no-reply@suplenitud.com

# Buzón de peticiones para la ruta Correo del panel (contraseña de aplicación recomendada)
MAIL_HOST=mail.suplenitud.com
MAIL_USER=peticiones@suplenitud.com
MAIL_PASS=
