# Plantilla de variables de entorno para producción (VPS)
# Copiar como .env en /opt/ipec-v3/ en el VPS
# NUNCA subir el .env real al repositorio

# ─── PostgreSQL ──────────────────────────────────────────────
# Genera una contraseña segura: openssl rand -base64 32
POSTGRES_PASSWORD=CAMBIAR_POR_CONTRASENA_SEGURA

# ─── SuperAdmin inicial ───────────────────────────────────────
# Se crea al primer arranque si no existe el usuario en la BD
SUPERADMIN_EMAIL=correo.real@iglesia.com
SUPERADMIN_NAME=Nombre Real Admin
SUPERADMIN_PASSWORD=CAMBIAR_POR_CONTRASENA_REAL

# ─── Sesiones ─────────────────────────────────────────────────
# Genera un secreto aleatorio: openssl rand -hex 32
SESSION_SECRET=CAMBIAR_POR_SECRETO_ALEATORIO_SEGURO
