generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Texto o dato editable del sitio. locale = en|es|pt|ko|de, o "all" para datos que no cambian
// con el idioma (dirección, teléfono, enlaces, imágenes). Guardar publica de inmediato.
model ContentEntry {
  id        String            @id @default(cuid())
  section   String            @db.VarChar(40)
  key       String            @db.VarChar(80)
  locale    String            @db.VarChar(5)
  value     String            @db.Text
  updatedAt DateTime          @updatedAt
  // Quién hizo el último cambio; pasa a relación con User en la fase 5
  updatedBy String?           @db.VarChar(120)
  revisions ContentRevision[]

  @@unique([section, key, locale])
  @@index([locale])
}

// Historial: cada guardado deja el valor anterior para poder restaurarlo
model ContentRevision {
  id        String       @id @default(cuid())
  entryId   String
  entry     ContentEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  oldValue  String       @db.Text
  newValue  String       @db.Text
  changedBy String?      @db.VarChar(120)
  changedAt DateTime     @default(now())

  @@index([entryId, changedAt(sort: Desc)])
}

// Pedido de oración enviado desde Contact us. Solo nombre y petición (decisión de Juan): no se guarda correo ni IP.
enum PrayerStatus {
  NEW
  DOWNLOADED
}

model PrayerRequest {
  id        String       @id @default(cuid())
  name      String       @db.VarChar(100)
  request   String       @db.VarChar(500)
  locale    String       @db.VarChar(5)
  source    String       @default("website") @db.VarChar(20)
  status    PrayerStatus @default(NEW)
  createdAt DateTime     @default(now())

  // El admin los lista del más reciente al más viejo
  @@index([createdAt(sort: Desc)])
  @@index([status, createdAt(sort: Desc)])
}

// Imagen subida desde el panel (se sirve desde /api/media/[id]; la BD es el almacenamiento para que sobreviva a los despliegues)
model MediaAsset {
  id        String   @id @default(cuid())
  mimeType  String   @db.VarChar(30)
  size      Int
  data      Bytes
  createdBy String?  @db.VarChar(120)
  createdAt DateTime @default(now())
}

// Visita a una página pública. No guarda IP: el visitante se distingue con un hash diario.
model PageVisit {
  id          String   @id @default(cuid())
  path        String   @db.VarChar(200)
  locale      String   @db.VarChar(5)
  country     String?  @db.VarChar(2)
  device      String   @db.VarChar(10)
  visitorHash String   @db.VarChar(64)
  createdAt   DateTime @default(now())

  @@index([createdAt(sort: Desc)])
}

// ── Admin: usuarios, sesiones e invitaciones ─────────────────────────────────

enum Role {
  SUPERADMIN
  ADMIN
  USER
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique @db.VarChar(120)
  name         String   @db.VarChar(100)
  passwordHash String   @db.VarChar(256)
  role         Role     @default(USER)
  // Obsoleto: el idioma del panel vive en localStorage. Se conserva para poder volver a la versión anterior; quitar en una publicación posterior
  adminLocale  String   @default("en") @db.VarChar(5)
  // Contacto para avisos de pedidos de oración
  phone          String? @db.VarChar(30)
  whatsapp       String? @db.VarChar(30)
  telegramChatId String? @db.VarChar(40)
  // Permisos por sección para role USER (JSON: {"hero":true,"about":false,...})
  permissions  Json     @default("{}")
  // Avisos de pedidos de oración
  notifyTelegram Boolean @default(false)
  notifyEmail    Boolean @default(false)
  // 2FA (TOTP)
  twoFactorSecret  String?  @db.VarChar(256)
  twoFactorEnabled Boolean  @default(false)
  // Minutos de inactividad antes de cerrar sesión (0 = no expira por inactividad)
  sessionTimeout   Int      @default(480)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  sessions    Session[]
  invitedBy   User?       @relation("InvitedBy", fields: [invitedById], references: [id])
  invitedById String?
  invited     User[]      @relation("InvitedBy")
}

// Sesión activa. Se elimina al cerrar sesión o al expirar.
model Session {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token          String   @unique @db.VarChar(128)
  expiresAt      DateTime
  lastActivityAt DateTime @default(now())
  createdAt      DateTime @default(now())

  @@index([token])
  @@index([userId])
}

// Invitación de un solo uso. El invitado crea su contraseña al abrirla.
model Invitation {
  id        String    @id @default(cuid())
  email     String    @db.VarChar(120)
  name      String    @db.VarChar(100)
  role      Role      @default(USER)
  token     String    @unique @db.VarChar(128)
  expiresAt DateTime
  usedAt    DateTime?
  invitedBy String    @db.VarChar(120)
  createdAt DateTime  @default(now())

  @@index([token])
}
